ANTHROPIC_API_KEY=your_key_here
DEMO_MODE=false
ALLOWED_ORIGINS=*

# --- Slack notifications (either or both) ---
# Simplest option: Slack Incoming Webhook URL for one-way notifications.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Full interactive bot (adds "Approve & Publish" buttons in Slack).
# Create a Slack app at https://api.slack.com/apps, enable Interactivity
# with Request URL = https://<your-host>/slack/interactions, install it to
# your workspace, and invite the bot to SLACK_CHANNEL.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=

# --- Publishing credentials (set the ones you want to enable) ---
# LinkedIn: create an app at https://www.linkedin.com/developers/, request
# w_member_social scope, get a user or org access token + author URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X (Twitter): create a project/app at https://developer.x.com/, generate a
# user-context OAuth 2.0 access token with tweet.write scope.
X_ACCESS_TOKEN=

# Instagram: Meta Graph API, needs a Business/Creator account linked to a
# Facebook Page, a long-lived access token, and an image URL (feed posts
# require media).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEFAULT_IMAGE_URL=

# Email: free tier at https://resend.com/
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_LIST=

# --- Inbound concierge bot (answers event questions over WhatsApp + email) ---
# The bot receives questions via webhook, answers them from the RAG service,
# and replies on the same channel. It works fully without credentials (replies
# are logged as no-ops) so you can test the receive->answer path first.

# Where the bot reaches the RAG service (rag-backend, default port 8001).
RAG_URL=http://127.0.0.1:8001

# WhatsApp: Meta WhatsApp Business Cloud API (free tier).
# 1. Create an app at https://developers.facebook.com/ and add WhatsApp.
# 2. Set the webhook callback URL to https://<your-host>/bot/whatsapp and the
#    verify token below; subscribe to the "messages" field.
# 3. Copy the temporary/permanent access token and phone number ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard. When set, inbound webhooks are
# verified against Meta's X-Hub-Signature-256 header; leave empty for testing.
WHATSAPP_APP_SECRET=

# Email replies reuse the Resend credentials above (RESEND_API_KEY /
# RESEND_FROM_EMAIL). To receive inbound email, point your provider's
# inbound-parse webhook (SendGrid, Mailgun, or Resend) at
# https://<your-host>/bot/email

# --- Luma event creation (browser automation) ---
# When an organizer creates an event in OutPace HQ, the backend automatically
# creates a corresponding Luma event and returns the link. Requires a pre-configured
# Luma organizer account (uses Playwright for browser automation; free and headless).
LUMA_EMAIL=organizer@example.com
LUMA_PASSWORD=your_luma_password
LUMA_HEADLESS=true
